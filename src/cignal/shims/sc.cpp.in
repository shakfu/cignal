// Generated by cignal: SuperCollider UGen `${sc_name}` for kernel ${name}.
// Inputs: the signal inputs, then one input per parameter, read once per block. A `reset` unit command
// (`/u_cmd node ugen "reset"`) clears all state except the parameters. Each event `on_<name>` is a unit
// command `<name>` with its arguments; missing ones are 0. An event sees the parameters as of the last
// block: inputs are read in the calc function, which runs after the command.
#include "SC_PlugIn.h"

#include "${header}"

${ftz}

#define NIN ${n_inputs}
#define NOUT ${n_outputs}
#define NPARAMS ${n_params}
#define NEVARGS ${max_event_args}

static_assert(sizeof(float) == sizeof(${sample}), "SuperCollider buffers are float; build the float variant");

static InterfaceTable *ft;

struct ${sc_name} : public Unit {
    ${name} kernel;
};

static void ${sc_name}_next(${sc_name} *unit, int inNumSamples) {
    const float *in[NIN > 0 ? NIN : 1];
    float *out[NOUT];
    for (int c = 0; c < NIN; c++) in[c] = IN(c);
    for (int c = 0; c < NOUT; c++) out[c] = OUT(c);
    for (int p = 0; p < NPARAMS; p++) ${name}_set_param(&unit->kernel, p, IN0(NIN + p));
    cignal_fp_mode mode = cignal_ftz_begin();
    ${name}_process(&unit->kernel, in, out, inNumSamples);
    cignal_ftz_end(mode);
}

static void ${sc_name}_Ctor(${sc_name} *unit) {
    // The struct lives in the server's real-time pool; init writes every field.
    ${name}_init(&unit->kernel, (float)SAMPLERATE);
    for (int p = 0; p < NPARAMS; p++) ${name}_set_param(&unit->kernel, p, IN0(NIN + p));
    SETCALC(${sc_name}_next);
    // Not next(1): processing a sample here would run the first input sample through the kernel twice.
    for (int c = 0; c < NOUT; c++) OUT0(c) = 0.f;
}

static void ${sc_name}_reset(${sc_name} *unit, struct sc_msg_iter *) {
    ${name}_reset(&unit->kernel);
}

template <int E> static void ${sc_name}_event(${sc_name} *unit, struct sc_msg_iter *msg) {
    ${sample} args[NEVARGS];
    for (int a = 0; a < NEVARGS; a++) args[a] = a < ${name}_info.events[E].n_args ? msg->getf(0.f) : 0.f;
    ${name}_event(&unit->kernel, E, args);
}

PluginLoad(${sc_name}) {
    ft = inTable;
    DefineSimpleUnit(${sc_name});
    DefineUnitCmd("${sc_name}", "reset", (UnitCmdFunc)&${sc_name}_reset);
${sc_event_cmds}}
