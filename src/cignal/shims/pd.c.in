/* Generated by cignal: Pd external `${pd_name}` for kernel ${name}.
   Inlets: the signal inputs, then one float inlet per parameter. A kernel without signal inputs takes
   its first parameter on the left inlet. Creation arguments set the parameters in order. A `reset`
   message clears all state except the parameters. Each event `on_<name>` is a message `<name> args...`;
   missing arguments are 0. */
#include <string.h>

#include "m_pd.h"

#include "${header}"

${ftz}

#define NIN ${n_inputs}
#define NOUT ${n_outputs}
#define NPARAMS ${n_params}
#define NEVENTS ${n_events}
#define NEVARGS ${max_event_args}

/* The kernel processes t_sample buffers in place, so the two types must match. */
typedef char cignal_sample_size_check[sizeof(t_sample) == sizeof(${sample}) ? 1 : -1];

static t_class *${c_prefix}_class;

typedef struct {
    t_object x_obj;
    t_float x_f;
    t_float sample_rate;
    t_float params[NPARAMS > 0 ? NPARAMS : 1];
    ${name} kernel;
} t_${c_prefix};

static t_int *${c_prefix}_perform(t_int *w) {
    t_${c_prefix} *x = (t_${c_prefix} *)(w[1]);
    int n = (int)(w[2]);
    const ${sample} *in[NIN > 0 ? NIN : 1];
    ${sample} *out[NOUT];
    for (int c = 0; c < NIN; c++) in[c] = (const ${sample} *)(w[3 + c]);
    for (int c = 0; c < NOUT; c++) out[c] = (${sample} *)(w[3 + NIN + c]);
    /* Inlets write x->params directly; the setter clamps. */
    for (int p = 0; p < NPARAMS; p++) ${name}_set_param(&x->kernel, p, (${sample})x->params[p]);
    cignal_fp_mode mode = cignal_ftz_begin();
    ${name}_process(&x->kernel, in, out, n);
    cignal_ftz_end(mode);
    return w + 3 + NIN + NOUT;
}

static void ${c_prefix}_dsp(t_${c_prefix} *x, t_signal **sp) {
    t_int args[2 + NIN + NOUT];
    /* Re-initialise only when the rate changes: Pd calls dsp on every graph change. Parameters
       survive because perform re-applies them. */
    if (sp[0]->s_sr != x->sample_rate) {
        x->sample_rate = sp[0]->s_sr;
        ${name}_init(&x->kernel, (${sample})x->sample_rate);
    }
    args[0] = (t_int)x;
    args[1] = (t_int)sp[0]->s_n;
    for (int c = 0; c < NIN + NOUT; c++) args[2 + c] = (t_int)sp[c]->s_vec;
    dsp_addv(${c_prefix}_perform, 2 + NIN + NOUT, args);
}

static void ${c_prefix}_reset(t_${c_prefix} *x) {
    ${name}_reset(&x->kernel);
}

#if NEVENTS > 0
static void ${c_prefix}_event(t_${c_prefix} *x, t_symbol *s, int argc, t_atom *argv) {
    ${sample} args[NEVARGS];
    int e = 0;
    while (e < NEVENTS && strcmp(${name}_info.events[e].name, s->s_name) != 0) e++;
    if (e == NEVENTS) return;
    for (int a = 0; a < NEVARGS; a++) args[a] = a < argc ? (${sample})atom_getfloat(argv + a) : 0;
    /* Inlets reach the kernel at the next DSP tick, and this event runs now. Applying them first gives
       the event every parameter sent before it, in order, as in the driver. */
    for (int p = 0; p < NPARAMS; p++) ${name}_set_param(&x->kernel, p, (${sample})x->params[p]);
    ${name}_event(&x->kernel, e, args);
}
#endif

#if NIN == 0 && NPARAMS > 0
static void ${c_prefix}_float(t_${c_prefix} *x, t_floatarg f) {
    x->params[0] = f;
}
#endif

static void *${c_prefix}_new(t_symbol *s, int argc, t_atom *argv) {
    t_${c_prefix} *x = (t_${c_prefix} *)pd_new(${c_prefix}_class);
    (void)s;
    x->x_f = 0;
    for (int p = 0; p < NPARAMS; p++)
        x->params[p] = p < argc ? atom_getfloat(argv + p) : (t_float)${name}_info.params[p].def;
    x->sample_rate = sys_getsr();
    ${name}_init(&x->kernel, (${sample})x->sample_rate);
    for (int c = 1; c < NIN; c++) inlet_new(&x->x_obj, &x->x_obj.ob_pd, &s_signal, &s_signal);
    for (int p = NIN == 0 ? 1 : 0; p < NPARAMS; p++) floatinlet_new(&x->x_obj, &x->params[p]);
    for (int c = 0; c < NOUT; c++) outlet_new(&x->x_obj, &s_signal);
    return x;
}

void ${c_prefix}_setup(void) {
    ${c_prefix}_class = class_new(gensym("${pd_name}"), (t_newmethod)${c_prefix}_new, 0,
                                  sizeof(t_${c_prefix}), CLASS_DEFAULT, A_GIMME, 0);
#if NIN > 0
    CLASS_MAINSIGNALIN(${c_prefix}_class, t_${c_prefix}, x_f);
#elif NPARAMS > 0
    class_addfloat(${c_prefix}_class, (t_method)${c_prefix}_float);
#endif
    class_addmethod(${c_prefix}_class, (t_method)${c_prefix}_dsp, gensym("dsp"), A_CANT, 0);
    class_addmethod(${c_prefix}_class, (t_method)${c_prefix}_reset, gensym("reset"), 0);
#if NEVENTS > 0
    for (int e = 0; e < NEVENTS; e++)
        class_addmethod(${c_prefix}_class, (t_method)${c_prefix}_event, gensym(${name}_info.events[e].name), A_GIMME,
                        0);
#endif
}
