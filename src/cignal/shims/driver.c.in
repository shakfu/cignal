/* Generated by cignal: standalone driver for ${name}. Test and benchmark use only. */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "${header}"

#define NIN ${n_inputs}
#define NOUT ${n_outputs}
#define MAX_BLOCK 8192
#define MAX_PATTERN 256
#define MAX_CHANGES 256

typedef ${sample} sample_t;

static sample_t in_buf[NIN > 0 ? NIN : 1][MAX_BLOCK];
static sample_t out_buf[NOUT][MAX_BLOCK];

typedef struct {
    long frame;
    int index;
    double value;
} change_t;

static int usage(const char *argv0) {
    fprintf(stderr, "usage: %s SAMPLE_RATE BLOCKS [--frames N] [--set FRAME:INDEX:VALUE] [--reset FRAME]...\n",
            argv0);
    return 2;
}

/* BLOCKS is a comma-separated block-size pattern, repeated until the input ends. A block also ends
   at each --set or --reset frame, so the change takes effect at exactly that frame. Reads interleaved
   native-endian samples from stdin (or runs --frames frames for a kernel without inputs) and writes
   interleaved output to stdout. */
int main(int argc, char **argv) {
    if (argc < 3) return usage(argv[0]);
    double sample_rate = strtod(argv[1], NULL);
    int pattern[MAX_PATTERN];
    int n_pattern = 0;
    for (char *tok = strtok(argv[2], ","); tok && n_pattern < MAX_PATTERN; tok = strtok(NULL, ",")) {
        int b = atoi(tok);
        if (b < 1 || b > MAX_BLOCK) {
            fprintf(stderr, "block size %d out of range 1..%d\n", b, MAX_BLOCK);
            return 2;
        }
        pattern[n_pattern++] = b;
    }
    if (n_pattern == 0) return usage(argv[0]);

    long frames = -1;
    change_t changes[MAX_CHANGES];
    int n_changes = 0;
    for (int a = 3; a < argc; a++) {
        if (strcmp(argv[a], "--frames") == 0 && a + 1 < argc) {
            frames = atol(argv[++a]);
        } else if ((strcmp(argv[a], "--set") == 0 || strcmp(argv[a], "--reset") == 0) && a + 1 < argc &&
                   n_changes < MAX_CHANGES) {
            change_t *c = &changes[n_changes];
            if (strcmp(argv[a], "--reset") == 0) {
                c->index = -1; /* a reset, applied in order with the parameter changes */
                c->value = 0;
                if (sscanf(argv[++a], "%ld", &c->frame) != 1) return usage(argv[0]);
            } else if (sscanf(argv[++a], "%ld:%d:%lf", &c->frame, &c->index, &c->value) != 3) {
                return usage(argv[0]);
            }
            if (n_changes > 0 && c->frame < changes[n_changes - 1].frame) {
                fprintf(stderr, "--set and --reset frames must not decrease\n");
                return 2;
            }
            n_changes++;
        } else {
            return usage(argv[0]);
        }
    }

    size_t cap = 1 << 16, len = 0, got;
    unsigned char *data = malloc(cap);
    while (NIN > 0 && data && (got = fread(data + len, 1, cap - len, stdin)) > 0) {
        len += got;
        if (len == cap) data = realloc(data, cap *= 2);
    }
    if (!data) {
        fprintf(stderr, "out of memory\n");
        return 1;
    }
    /* The divisor is never 0, so GCC's -Wdiv-by-zero holds even where this branch is dead. */
    if (NIN > 0) frames = (long)(len / (sizeof(sample_t) * (NIN > 0 ? NIN : 1)));
    if (frames < 0) {
        fprintf(stderr, "a kernel without inputs needs --frames\n");
        return 2;
    }
    const sample_t *samples = (const sample_t *)data;

    ${name} kernel;
    ${name}_init(&kernel, (sample_t)sample_rate);
    const sample_t *in[NIN > 0 ? NIN : 1];
    sample_t *out[NOUT];
    for (int c = 0; c < NIN; c++) in[c] = in_buf[c];
    for (int c = 0; c < NOUT; c++) out[c] = out_buf[c];

    long pos = 0;
    int next = 0;
    for (int p = 0; pos < frames; p = (p + 1) % n_pattern) {
        while (next < n_changes && changes[next].frame <= pos) {
            if (changes[next].index < 0)
                ${name}_reset(&kernel);
            else
                ${name}_set_param(&kernel, changes[next].index, (sample_t)changes[next].value);
            next++;
        }
        long n = pattern[p];
        if (n > frames - pos) n = frames - pos;
        if (next < n_changes && changes[next].frame - pos < n) n = changes[next].frame - pos;
        for (long i = 0; i < n; i++)
            for (int c = 0; c < NIN; c++) in_buf[c][i] = samples[(pos + i) * NIN + c];
        ${name}_process(&kernel, in, out, (int)n);
        for (long i = 0; i < n; i++)
            for (int c = 0; c < NOUT; c++) fwrite(&out_buf[c][i], sizeof(sample_t), 1, stdout);
        pos += n;
    }
    free(data);
    return 0;
}
