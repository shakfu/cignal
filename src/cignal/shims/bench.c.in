/* Generated by cignal: benchmark for ${name}. Prints nanoseconds per sample frame. */
#define _POSIX_C_SOURCE 199309L
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#include "${header}"

#define NIN ${n_inputs}
#define NOUT ${n_outputs}
#define BLOCK 64
#define BLOCKS 64 /* 4096 frames of input, cycled */

static float in_buf[NIN > 0 ? NIN : 1][BLOCKS * BLOCK];
static float out_buf[NOUT][BLOCK];

static double now(void) {
    struct timespec t;
    clock_gettime(CLOCK_MONOTONIC, &t);
    return (double)t.tv_sec + (double)t.tv_nsec * 1e-9;
}

/* usage: bench [SECONDS] -- runs for at least SECONDS (default 0.25) and prints ns per frame. */
int main(int argc, char **argv) {
    double seconds = argc > 1 ? atof(argv[1]) : 0.25;
    unsigned int seed = 12345u;
    for (int c = 0; c < NIN; c++)
        for (int i = 0; i < BLOCKS * BLOCK; i++) {
            seed = seed * 1664525u + 1013904223u;
            in_buf[c][i] = (float)(seed >> 8) / 16777216.0f - 0.5f;
        }
    static ${name} kernel;
    ${name}_init(&kernel, 48000.0f);
    const float *in[NIN > 0 ? NIN : 1];
    float *out[NOUT];
    for (int c = 0; c < NOUT; c++) out[c] = out_buf[c];
    volatile float sink = 0.0f;
    long blocks = 0;
    double start = now(), elapsed = 0.0;
    do {
        for (int r = 0; r < 1024; r++, blocks++) {
            for (int c = 0; c < NIN; c++) in[c] = in_buf[c] + (blocks % BLOCKS) * BLOCK;
            ${name}_process(&kernel, in, out, BLOCK);
            sink += out[0][BLOCK - 1];
        }
        elapsed = now() - start;
    } while (elapsed < seconds);
    printf("%.4f\n", elapsed * 1e9 / ((double)blocks * BLOCK));
    return 0;
}
